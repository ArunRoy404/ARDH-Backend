# Copy this to `.env` in the SAME directory as docker-compose.yml, ON THE SERVER ONLY.
# docker compose reads a file literally named `.env` and substitutes ${VAR} placeholders
# in docker-compose.yml with these values. Never commit the real `.env` file.

# SQL Server "sa" login password. Must satisfy MSSQL complexity rules:
# 8+ chars, upper+lower+digit+symbol. Generate with: openssl rand -base64 24
MSSQL_SA_PASSWORD=

# JWT signing key. Generate with: openssl rand -base64 32
IDENTITY_KEY=

# Hostinger SMTP mailbox credentials (smtp.hostinger.com, port 465 SSL by default)
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USE_SSL=true
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=

# Password required for admin "delete" / X-Admin-Password protected endpoints
ADMIN_PANEL_PASSWORD=

# Bootstraps the first admin login, but ONLY if the database is completely empty
# (no users exist yet) - ignored on every later restart. Set a real value here on
# the server, never in source control.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional overrides for non-production deployments (e.g. a Coolify test subdomain).
# Leave unset on the main production server - defaults match the current prod setup.
# Container names must differ from the prod stack (ardh-api/ardh-db) since Coolify
# and the prod docker-compose deployment share the same Docker daemon.
# BASE_URL=https://dev-api.ardh.co.in
# API_HOST_PORT=127.0.0.1:8081
# API_CONTAINER_NAME=ardh-api-test
# DB_CONTAINER_NAME=ardh-db-test
