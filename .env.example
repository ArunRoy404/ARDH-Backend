# Copy this file to `.env` (repo root) and fill in real values. `.env` is gitignored — never commit it.
# Keys use .NET's environment-variable naming (__ = section separator) and are loaded at
# startup by DotEnvExtension.LoadDotEnv(). In production, set the same variables as real
# environment variables instead.

# Hostinger SMTP mailbox credentials -> MailConfigurations:*
# Host/Port/UseSsl default to smtp.hostinger.com:465 (SSL) in appsettings if left unset here.
MailConfigurations__Host=smtp.hostinger.com
MailConfigurations__Port=465
MailConfigurations__UseSsl=true
MailConfigurations__Username=no-reply@yourdomain.com
MailConfigurations__Password=CHANGE_ME_TO_YOUR_MAILBOX_PASSWORD
MailConfigurations__From=no-reply@yourdomain.com

# SQL Server connection string -> ConnectionStrings:DefaultConnection
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=ArdhDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Base URL -> BaseURL (used for building absolute file URLs; empty = fall back to AppUrl)
BaseURL=

# JWT signing key -> Identity:Key (generate with e.g. `openssl rand -base64 32`)
Identity__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Admin panel password seeded into the Settings table -> AdminSettings:Password
AdminSettings__Password=adminpassword
