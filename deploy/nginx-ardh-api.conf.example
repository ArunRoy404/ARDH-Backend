# Reference Nginx server block for the ARDH backend API.
# On the server, copy this to /etc/nginx/sites-available/ardh-api,
# replace api.yourdomain.com with your real subdomain, then:
#   sudo ln -s /etc/nginx/sites-available/ardh-api /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.yourdomain.com
# (certbot rewrites this file in place to add the SSL server block - that's expected.)

server {
    listen 80;
    server_name api.yourdomain.com;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
